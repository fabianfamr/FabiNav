{
  "name": "fabinav",
  "private": true,
  "version": "1.21.0",
  "description": "FabiNav — Navegador web privado con búsqueda en vivo, escudos TLS y compilación automática para escritorio",
  "homepage": "https://github.com/fabianfamr/FabiNav",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabianfamr/FabiNav.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-electron server.js",
    "lint": "tsc --noEmit",
    "electron:icons": "node scripts/generate-electron-icons.mjs",
    "electron:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs --external:vite",
    "electron:prepare": "npm run build && npm run electron:server && npm run electron:icons",
    "electron:setup": "npm install --no-save electron@^33.2.1 electron-builder@^25.1.8 electron-updater@^6.3.9",
    "electron:dev": "npx electron .",
    "electron:build": "npm run electron:prepare && npx electron-builder --config electron-builder.yml --publish never",
    "build:electron": "npm run electron:build",
    "electron:publish": "npm run electron:prepare && npx electron-builder --config electron-builder.yml --publish always"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
